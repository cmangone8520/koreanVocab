# Copy this file to .env and fill in your OpenAI API key.
# .env is gitignored.

OPENAI_API_KEY=

# Optional: override the SQLite file location (defaults to backend/korean_vocab.db).
# DATABASE_PATH=./korean_vocab.db

# Optional: OpenAI TTS voice used for the listening module.
# Valid values: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=nova
